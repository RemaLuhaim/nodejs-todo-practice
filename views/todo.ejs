<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>To Do Task</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body{
            background-color: rgb(247,240,233);
        }

        .h1{
            color: rgb(89,60,44);
            text-align: center;
            margin-top: 30px;
            margin-bottom: 30px;
        }

        .main-box{
            width: 60%;
            margin: auto;
            background-color: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0px 4px 12px rgba(0,0,0,0.1);
        }

        .form-label{
            font-weight: bold;
        }

        .btn-add{
            background-color: rgb(166,123,91);
            color: white;
            border: none;
        }

        .btn-add:hover{
            background-color: rgb(140,101,73);
            color: white;
        }

        .btn-update{
            background-color: rgb(184,146,118);
            color: white;
            border: none;
        }

        .btn-update:hover{
            background-color: rgb(155,120,95);
            color: white;
        }

        .btn-delete{
            background-color: rgb(120,120,120);
            color: white;
            border: none;
        }

        .btn-delete:hover{
            background-color: rgb(90,90,90);
            color: white;
        }

        .task-box{
            background-color: rgb(252,248,244);
            border: 1px solid rgb(232,220,210);
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .task-title{
            font-size: 18px;
            font-weight: bold;
            color: rgb(89,60,44);
        }

        .task-description{
            color: rgb(110,88,74);
        }

        .task-date{
            color: gray;
            font-size: 14px;
        }
        .form-label{
    font-weight: bold;
}
    </style>
</head>
<body>

    <h1 class="h1">To Do Task</h1>

    <div class="main-box">

        <form action="/createTask" method="post">

            <div class="mb-3">
                <label class="form-label">Task Title</label>
                <input
                    type="text"
                    class="form-control"
                    name="title"
                    placeholder="Enter your task title">
            </div>

            <div class="mb-3">
                <label class="form-label">Task Description</label>
                <textarea
                    class="form-control"
                    name="description"
                    rows="3"
                    placeholder="Enter your task description"></textarea>
            </div>

            <button type="submit" class="btn btn-add">Add Task</button>

        </form>

        <hr>

        <% tasks.forEach(task => { %>

            <div class="task-box">

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox">
                    <label class="form-check-label">
                        <%= task.title %>
                    </label>
                </div>

                <div class="task-description">
                    <%= task.description %>
                </div>

                <div class="task-date">
                    <%= task.date.toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %>
                </div>

                <br>

                <form action="/update/<%= task._id %>" method="post">

                    <input
                        type="text"
                        class="form-control mb-2"
                        name="title"
                        placeholder="Edit title">

                    <textarea
                        class="form-control mb-2"
                        name="description"
                        rows="2"
                        placeholder="Edit description"></textarea>

                    <button class="btn btn-update btn-sm">Update</button>

                </form>

                <br>

                <form action="/delete/<%= task._id %>" method="post">
                    <button class="btn btn-delete btn-sm">Delete</button>
                </form>

            </div>

        <% }) %>

    </div>

</body>
</html>